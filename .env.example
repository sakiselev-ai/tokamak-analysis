# PostgreSQL
POSTGRES_USER=tokamak
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=tokamak_db
DATABASE_URL=postgresql+asyncpg://tokamak:changeme_in_production@postgres:5432/tokamak_db

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_DATA=data

# JWT
JWT_SECRET_KEY=changeme_jwt_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Service
ML_SERVICE_URL=http://ml-service:8001

# FAIR-MAST
FAIR_MAST_S3_ENDPOINT=https://s3.echo.stfc.ac.uk
FAIR_MAST_BUCKET=mast

# App
APP_ENV=development
APP_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:80
