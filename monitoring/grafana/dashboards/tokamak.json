      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(tokamak_inference_duration_seconds_bucket[5m]))",
          "legendFormat": "backend p50 {{model_type}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(tokamak_inference_duration_seconds_bucket[5m]))",
          "legendFormat": "backend p95 {{model_type}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, rate(ml_inference_duration_seconds_bucket[5m]))",
          "legendFormat": "ml p50 {{model_type}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ml_inference_duration_seconds_bucket[5m]))",
          "legendFormat": "ml p95 {{model_type}}",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Experiments Loaded",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "tokamak_experiments_loaded_total",
          "legendFormat": "experiments",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Predictions Total",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(tokamak_predictions_total) by (model_type)",
          "legendFormat": "{{model_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 100 }
